  "glossary": {
    "sharpeRatio": {
      "term": "Ratio de Sharpe",
      "definition": "Mesure le rendement ajusté au risque. Calculé comme (Rendement - Taux Sans Risque) / Écart-type des rendements.",
      "formula": "SR = (Rp - Rf) / σp",
      "interpretation": "> 1: Bon, > 2: Excellent, < 1: Mauvais"
    },
    "profitFactor": {
      "term": "Facteur de Profit",
      "definition": "Ratio du bénéfice brut sur la perte brute. Montre la rentabilité globale.",
      "formula": "PF = Bénéfice Brut / Perte Brute",
      "interpretation": "> 1.5: Bon, > 2: Excellent"
    },
    "maxDrawdown": {
      "term": "Drawdown Maximum (MDD)",
      "definition": "La plus grande baisse du pic au creux dans la courbe d'équité.",
      "formula": "MDD = (Pic - Creux) / Pic × 100%",
      "interpretation": "Plus bas c'est mieux. < 20% est acceptable"
    },
    "winRate": {
      "term": "Taux de Réussite",
      "definition": "Pourcentage de trades rentables.",
      "formula": "WR = Trades Gagnants / Total Trades × 100%",
      "interpretation": "> 50% avec risque-rendement positif est rentable"
    },
    "calmarRatio": {
      "term": "Ratio de Calmar",
      "definition": "Métrique de rendement ajusté au risque comparant le rendement annualisé au drawdown maximum.",
      "formula": "CR = Rendement Annualisé / |MDD|",
      "interpretation": "> 1: Bon, > 3: Excellent"
    },
    "sortinoRatio": {
      "term": "Ratio de Sortino",
      "definition": "Similaire au Ratio de Sharpe mais ne considère que la volatilité à la baisse.",
      "formula": "SoR = (Rp - Rf) / σd",
      "interpretation": "Plus haut c'est mieux. Utilise l'écart-type à la baisse"
    },
    "alpha": {
      "term": "Alpha",
      "definition": "Rendement excédentaire d'un investissement par rapport à un indice de référence.",
      "formula": "α = Rp - [Rf + β(Rm - Rf)]",
      "interpretation": "Alpha positif indique une surperformance"
    },
    "beta": {
      "term": "Bêta",
      "definition": "Mesure de la volatilité par rapport au marché.",
      "formula": "β = Cov(Ri, Rm) / Var(Rm)",
      "interpretation": "β > 1: Plus volatile, < 1: Moins volatile"
    },
    "volatility": {
      "term": "Volatilité",
      "definition": "Mesure statistique de la dispersion des rendements.",
      "formula": "σ = √(Σ(ri - r̄)² / (n-1))",
      "interpretation": "Plus haute volatilité = plus haut risque"
    },
    "informationRatio": {
      "term": "Ratio d'Information",
      "definition": "Mesure les rendements ajustés au risque par rapport à une référence.",
      "formula": "IR = (Rp - Rb) / Erreur de Suivi",
      "interpretation": "> 0.5: Bon, > 1: Excellent"
    }
  }
}
