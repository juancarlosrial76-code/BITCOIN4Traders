  "glossary": {
    "sharpeRatio": {
      "term": "Wskaźnik Sharpa",
      "definition": "Mierzy zwrot skorygowany o ryzyko. Obliczany jako (Zwrot - Stopa Bez Ryzyka) / Odchylenie standardowe.",
      "formula": "SR = (Rp - Rf) / σp",
      "interpretation": "> 1: Dobry, > 2: Doskonały, < 1: Zły"
    },
    "profitFactor": {
      "term": "Współczynnik Zysku",
      "definition": "Stosunek zysku brutto do straty brutto. Pokazuje ogólną rentowność.",
      "formula": "PF = Zysk Brutto / Strata Brutto",
      "interpretation": "> 1.5: Dobry, > 2: Doskonały"
    },
    "maxDrawdown": {
      "term": "Maksymalny Drawdown (MDD)",
      "definition": "Największy spadek od szczytu do dołka na krzywej kapitału.",
      "formula": "MDD = (Szczyt - Dołek) / Szczyt × 100%",
      "interpretation": "Mniejszy jest lepszy. < 20% jest akceptowalne"
    },
    "winRate": {
      "term": "Wskaźnik Wygranych",
      "definition": "Procent zyskownych handli.",
      "formula": "WR = Handle Wygrane / Wszystkie Handle × 100%",
      "interpretation": "> 50% z dodatnim ryzykiem-zwrotem jest zyskowne"
    },
    "calmarRatio": {
      "term": "Wskaźnik Calmara",
      "definition": "Metryka zwrotu skorygowanego o ryzyko porównująca roczny zwrot do maksymalnego drawdownu.",
      "formula": "CR = Zwrot Roczny / |MDD|",
      "interpretation": "> 1: Dobry, > 3: Doskonały"
    },
    "sortinoRatio": {
      "term": "Wskaźnik Sortino",
      "definition": "Podobny do Wskaźnika Sharpa ale uwzględnia tylko zmienność spadkową.",
      "formula": "SoR = (Rp - Rf) / σd",
      "interpretation": "Wyższy jest lepszy. Używa odchylenia dolnego"
    },
    "alpha": {
      "term": "Alfa",
      "definition": "Nadmierny zwrot inwestycji względem indeksu referencyjnego.",
      "formula": "α = Rp - [Rf + β(Rm - Rf)]",
      "interpretation": "Dodatnia alfa wskazuje na outperformance"
    },
    "beta": {
      "term": "Beta",
      "definition": "Miara zmienności względem rynku.",
      "formula": "β = Cov(Ri, Rm) / Var(Rm)",
      "interpretation": "β > 1: Bardziej zmienna, < 1: Mniej zmienna"
    },
    "volatility": {
      "term": "Zmienność",
      "definition": "Statystyczna miara dyspersji zwrotów.",
      "formula": "σ = √(Σ(ri - r̄)² / (n-1))",
      "interpretation": "Wyższa zmienność oznacza wyższe ryzyko"
    },
    "informationRatio": {
      "term": "Wskaźnik Informacji",
      "definition": "Mierzy zwroty skorygowane o ryzyko względem referencji.",
      "formula": "IR = (Rp - Rb) / Błąd Tracking",
      "interpretation": "> 0.5: Dobry, > 1: Doskonały"
    }
  }
}
