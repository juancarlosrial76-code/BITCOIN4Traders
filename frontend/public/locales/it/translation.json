  "glossary": {
    "sharpeRatio": {
      "term": "Rapporto di Sharpe",
      "definition": "Misura il rendimento ajustato al rischio. Calcolato come (Rendimento - Tasso Senza Rischio) / Deviazione Standard dei rendimenti.",
      "formula": "SR = (Rp - Rf) / σp",
      "interpretation": "> 1: Buono, > 2: Eccellente, < 1: Scarso"
    },
    "profitFactor": {
      "term": "Fattore di Profitto",
      "definition": "Rapporto tra profitto lordo e perdita lorda. Mostra la redditività complessiva.",
      "formula": "PF = Profitto Lordo / Perdita Lorda",
      "interpretation": "> 1.5: Buono, > 2: Eccellente"
    },
    "maxDrawdown": {
      "term": "Drawdown Massimo (MDD)",
      "definition": "Il più grande calo dal picco al minimo nella curva del capitale.",
      "formula": "MDD = (Picco - Minimo) / Picco × 100%",
      "interpretation": "Più basso è meglio. < 20% è accettabile"
    },
    "winRate": {
      "term": "Tasso di Vincita",
      "definition": "Percentuale di trade redditizi.",
      "formula": "WR = Trade Vincenti / Totale Trade × 100%",
      "interpretation": "> 50% con rischio-rendimento positivo è redditizio"
    },
    "calmarRatio": {
      "term": "Rapporto di Calmar",
      "definition": "Metrica di rendimento ajustato al rischio che confronta il rendimento annualizzato con il drawdown massimo.",
      "formula": "CR = Rendimento Annualizzato / |MDD|",
      "interpretation": "> 1: Buono, > 3: Eccellente"
    },
    "sortinoRatio": {
      "term": "Rapporto di Sortino",
      "definition": "Simile al Rapporto di Sharpe ma considera solo la volatilità al ribasso.",
      "formula": "SoR = (Rp - Rf) / σd",
      "interpretation": "Più alto è meglio. Usa la deviazione al ribasso"
    },
    "alpha": {
      "term": "Alpha",
      "definition": "Rendimento eccedente di un investimento rispetto a un indice di riferimento.",
      "formula": "α = Rp - [Rf + β(Rm - Rf)]",
      "interpretation": "Alpha positivo indica sovraperformance"
    },
    "beta": {
      "term": "Beta",
      "definition": "Misura della volatilità rispetto al mercato.",
      "formula": "β = Cov(Ri, Rm) / Var(Rm)",
      "interpretation": "β > 1: Più volatile, < 1: Meno volatile"
    },
    "volatility": {
      "term": "Volatilità",
      "definition": "Misura statistica della dispersione dei rendimenti.",
      "formula": "σ = √(Σ(ri - r̄)² / (n-1))",
      "interpretation": "Maggiore volatilità significa maggiore rischio"
    },
    "informationRatio": {
      "term": "Rapporto di Informazione",
      "definition": "Misura i rendimenti ajustati al rischio rispetto a un riferimento.",
      "formula": "IR = (Rp - Rb) / Errore di Tracking",
      "interpretation": "> 0.5: Buono, > 1: Eccellente"
    }
  }
}
