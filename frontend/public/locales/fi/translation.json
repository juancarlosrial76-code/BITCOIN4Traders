  "glossary": {
    "sharpeRatio": {
      "term": "Sharpe-suhde",
      "definition": "Riskikorjatun tuoton mitta. Lasketaan (Tuotto - Riskitön korko) / Tuoton keskihajonta.",
      "formula": "SR = (Rp - Rf) / σp",
      "interpretation": "> 1: Hyvä, > 2: Erinomainen, < 1: Huono"
    },
    "profitFactor": {
      "term": "Voittokerroin",
      "definition": "Bruttovoiton ja bruttotappion suhde. Näyttää kokonaiskannattavuuden.",
      "formula": "PF = Bruttovoitto / Bruttotappio",
      "interpretation": "> 1.5: Hyvä, > 2: Erinomainen"
    },
    "maxDrawdown": {
      "term": "Maksimaalinen piirto (MDD)",
      "definition": "Suurin huippu-pohja-lasku oma pääoma -käyrässä.",
      "formula": "MDD = (Huippu - Pohja) / Huippu × 100%",
      "interpretation": "Pienempi on parempi. < 20% on hyväksyttävää"
    },
    "winRate": {
      "term": "Voittoprosentti",
      "definition": "Tuottavien kauppojen prosenttiosuus.",
      "formula": "WR = Voittavat kaupat / Kaikki kaupat × 100%",
      "interpretation": "> 50% positiivisella riski-tuotto-suhteella on kannattava"
    },
    "calmarRatio": {
      "term": "Calmar-suhde",
      "definition": "Riskikorjattu tuottomittari, joka vertaa vuotuista tuottoa maksimaaliseen piirtoon.",
      "formula": "CR = Vuotuinen tuotto / |MDD|",
      "interpretation": "> 1: Hyvä, > 3: Erinomainen"
    },
    "sortinoRatio": {
      "term": "Sortino-suhde",
      "definition": "Samankaltainen kuin Sharpe-suhde, mutta huomioi vain alaspäisen volatiliteetin.",
      "formula": "SoR = (Rp - Rf) / σd",
      "interpretation": "Korkeampi on parempi. Käyttää alaspäistä poikkeamaa"
    },
    "alpha": {
      "term": "Alfa",
      "definition": "Sijoituksen ylituotto suhteessa vertailuindeksiin.",
      "formula": "α = Rp - [Rf + β(Rm - Rf)]",
      "interpretation": "Positiivinen alfa osoittaa ylisuorituskykyä"
    },
    "beta": {
      "term": "Beeta",
      "definition": "Volatiliteetin mitta suhteessa markkinaan.",
      "formula": "β = Cov(Ri, Rm) / Var(Rm)",
      "interpretation": "β > 1: Volatilimpi, < 1: Vähemmän volatili"
    },
    "volatility": {
      "term": "Volatiliteetti",
      "definition": "Tuottojen hajonnan tilastollinen mitta.",
      "formula": "σ = √(Σ(ri - r̄)² / (n-1))",
      "interpretation": "Korkea volatiliteetti tarkoittaa korkeaa riskiä"
    },
    "informationRatio": {
      "term": "Informaatiosuhde",
      "definition": "Mittaa riskikorjattuja tuottoja suhteessa vertailuun.",
      "formula": "IR = (Rp - Rb) / Seurantavirhe",
      "interpretation": "> 0.5: Hyvä, > 1: Erinomainen"
    }
  }
}
