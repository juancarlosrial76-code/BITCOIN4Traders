  "glossary": {
    "sharpeRatio": {
      "term": "シャープレシオ",
      "definition": "リスク調整後のリターンを測定します。計算式：(リターン - 無リスク金利) / リターンの標準偏差",
      "formula": "SR = (Rp - Rf) / σp",
      "interpretation": "> 1: 良好, > 2: 優秀, < 1: 不良"
    },
    "profitFactor": {
      "term": "プロフィットファクター",
      "definition": "総利益と総損失の比率。全体的な収益性を示す。",
      "formula": "PF = 総利益 / 総損失",
      "interpretation": "> 1.5: 良好, > 2: 優秀"
    },
    "maxDrawdown": {
      "term": "最大ドローダウン (MDD)",
      "definition": "Equity曲線におけるピークからトラフへの最大下降。",
      "formula": "MDD = (ピーク - トラフ) / ピーク × 100%",
      "interpretation": "低いほど良い。< 20%は許容可能"
    },
    "winRate": {
      "term": "勝率",
      "definition": "収益取引の割合。",
      "formula": "WR = 勝ち取引 / 全取引 × 100%",
      "interpretation": "> 50%でリスク・リターンが正であれば収益性あり"
    },
    "calmarRatio": {
      "term": "カルマーレシオ",
      "definition": "年率リターンと最大ドローダウンの比較によるリスク調整リターンメトリクス。",
      "formula": "CR = 年率リターン / |MDD|",
      "interpretation": "> 1: 良好, > 3: 優秀"
    },
    "sortinoRatio": {
      "term": "ソルティノレシオ",
      "definition": "シャープレトリオに類似するが、下振れリスクのみを考慮する。",
      "formula": "SoR = (Rp - Rf) / σd",
      "interpretation": "高いほど良い。下振れ偏差を使用"
    },
    "alpha": {
      "term": "アルファ",
      "definition": "ベンチマークインデックスに対する投資の超過リターン。",
      "formula": "α = Rp - [Rf + β(Rm - Rf)]",
      "interpretation": "正的アルファはアウトパフォーマンスを示す"
    },
    "beta": {
      "term": "ベータ",
      "definition": "市場に対するボラティリティの尺度。",
      "formula": "β = Cov(Ri, Rm) / Var(Rm)",
      "interpretation": "β > 1: ボラティリティ高い, < 1: ボラティリティ低い"
    },
    "volatility": {
      "term": "ボラティリティ",
      "definition": "リターンの分散度の統計的尺度。",
      "formula": "σ = √(Σ(ri - r̄)² / (n-1))",
      "interpretation": "ボラティリティ高い = リスク高い"
    },
    "informationRatio": {
      "term": "インフォメーションレシオ",
      "definition": "ベンチマークに対するリスク調整リターンを測定。",
      "formula": "IR = (Rp - Rb) / トラッキングエラー",
      "interpretation": "> 0.5: 良好, > 1: 優秀"
    }
  }
}
