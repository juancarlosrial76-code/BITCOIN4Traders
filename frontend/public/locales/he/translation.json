  "glossary": {
    "sharpeRatio": {
      "term": "יחס שארפ",
      "definition": "מדד לתשואה מותאמת לסיכון. מחושב כ(תשואה - שיעור חסר סיכון) / סטיית תקן של תשואות.",
      "formula": "SR = (Rp - Rf) / σp",
      "interpretation": "> 1: טוב, > 2: מצוין, < 1: גרוע"
    },
    "profitFactor": {
      "term": "גורם רווח",
      "definition": "יחס בין רווח גולמי להפסד גולמי. מראה רווחיות כללית.",
      "formula": "PF = רווח גולמי / הפסד גולמי",
      "interpretation": "> 1.5: טוב, > 2: מצוין"
    },
    "maxDrawdown": {
      "term": "משיכה מקסימלית (MDD)",
      "definition": "הירידה הגדולה ביותר משיא לשפל בעקום ההון.",
      "formula": "MDD = (שיא - שפל) / שיא × 100%",
      "interpretation": "נמוך יותר עדיף. < 20% מקובל"
    },
    "winRate": {
      "term": "אחוז זכיות",
      "definition": "אחוז העסקאות הרווחיות.",
      "formula": "WR = עסקאות מרוויחות / סה\"כ עסקאות × 100%",
      "interpretation": "> 50% עם יחס סיכון-רווח חיובי הוא רווחי"
    },
    "calmarRatio": {
      "term": "יחס קלמר",
      "definition": "מדד תשואה מותאם לסיכון המשווה תשואה שנתית למשיכה מקסימלית.",
      "formula": "CR = תשואה שנתית / |MDD|",
      "interpretation": "> 1: טוב, > 3: מצוין"
    },
    "sortinoRatio": {
      "term": "יחס סורטינו",
      "definition": "דומה ליחס שארפ אך מתחשב רק בתנודתיות יורדת.",
      "formula": "SoR = (Rp - Rf) / σd",
      "interpretation": "גבוה יותר עדיף. משתמש בסטייה יורדת"
    },
    "alpha": {
      "term": "אלפא",
      "definition": "תשואה עודפת של השקעה ביחס למדד ייחוס.",
      "formula": "α = Rp - [Rf + β(Rm - Rf)]",
      "interpretation": "אלפא חיובי מציין ביצועים מעל הממוצע"
    },
    "beta": {
      "term": "בטא",
      "definition": "מדד לתנודתיות ביחס לשוק.",
      "formula": "β = Cov(Ri, Rm) / Var(Rm)",
      "interpretation": "β > 1: תנודתי יותר, < 1: פחות תנודתי"
    },
    "volatility": {
      "term": "תנודתיות",
      "definition": "מדד סטטיסטי של פיזור התשואות.",
      "formula": "σ = √(Σ(ri - r̄)² / (n-1))",
      "interpretation": "תנודתיות גבוהה פירושה סיכון גבוה"
    },
    "informationRatio": {
      "term": "יחס מידע",
      "definition": "מודד תשואות מותאמות לסיכון ביחס לייחוס.",
      "formula": "IR = (Rp - Rb) / שגיאת מעקב",
      "interpretation": "> 0.5: טוב, > 1: מצוין"
    }
  }
}
