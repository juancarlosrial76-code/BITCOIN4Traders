  "glossary": {
    "sharpeRatio": {
      "term": "Sharpe Oranı",
      "definition": "Risk ayarlı getiriyi ölçer. (Getiri - Risksiz Oran) / Getiri Standart Sapması olarak hesaplanır.",
      "formula": "SR = (Rp - Rf) / σp",
      "interpretation": "> 1: İyi, > 2: Mükemmel, < 1: Kötü"
    },
    "profitFactor": {
      "term": "Kar Faktörü",
      "definition": "Brüt karın brüt kayıba oranı. Genel karlılığı gösterir.",
      "formula": "PF = Brüt Kar / Brüt Kayıp",
      "interpretation": "> 1.5: İyi, > 2: Mükemmel"
    },
    "maxDrawdown": {
      "term": "Maksimum Drawdown (MDD)",
      "definition": "Öz sermaye eğrisinde zirveden diplere en büyük düşüş.",
      "formula": "MDD = (Zirve - Dip) / Zirve × 100%",
      "interpretation": "Düşük daha iyidir. < 20% kabul edilebilir"
    },
    "winRate": {
      "term": "Kazanma Oranı",
      "definition": "Karlı işlemlerin yüzdesi.",
      "formula": "WR = Karlı İşlemler / Toplam İşlem × 100%",
      "interpretation": "> 50% pozitif risk-getiri ile karlıdır"
    },
    "calmarRatio": {
      "term": "Calmar Oranı",
      "definition": "Yıllık getiriyi maksimum drawdown ile karşılaştıran risk ayarlı getiri metriği.",
      "formula": "CR = Yıllık Getiri / |MDD|",
      "interpretation": "> 1: İyi, > 3: Mükemmel"
    },
    "sortinoRatio": {
      "term": "Sortino Oranı",
      "definition": "Sharpe Oranı'na benzer ancak yalnızca aşağı yönlü volatiliteyi dikkate alır.",
      "formula": "SoR = (Rp - Rf) / σd",
      "interpretation": "Yüksek daha iyidir. Aşağı sapma kullanır"
    },
    "alpha": {
      "term": "Alfa",
      "definition": "Bir yatırımın benchmark endeksine göre fazla getirisi.",
      "formula": "α = Rp - [Rf + β(Rm - Rf)]",
      "interpretation": "Pozitif alfa performansın üzerinde olduğunu gösterir"
    },
    "beta": {
      "term": "Beta",
      "definition": "Pazara göre volatilite ölçüsü.",
      "formula": "β = Cov(Ri, Rm) / Var(Rm)",
      "interpretation": "β > 1: Daha volatil, < 1: Daha az volatil"
    },
    "volatility": {
      "term": "Volatilite",
      "definition": "Getirilerin dağılımının istatistiksel ölçüsü.",
      "formula": "σ = √(Σ(ri - r̄)² / (n-1))",
      "interpretation": "Yüksek volatilite = yüksek risk"
    },
    "informationRatio": {
      "term": "Bilgi Oranı",
      "definition": "Riske ayarlı getirileri benchmark'a göre ölçer.",
      "formula": "IR = (Rp - Rb) / Takip Hatası",
      "interpretation": "> 0.5: İyi, > 1: Mükemmel"
    }
  }
}
