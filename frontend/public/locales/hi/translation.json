  "glossary": {
    "sharpeRatio": {
      "term": "शार्प अनुपात",
      "definition": "जोखिम-समायोजित रिटर्न मापता है। (रिटर्न - रिस्क-फ्री रेट) / रिटर्न स्टैंडर्ड डेविएशन से गणना करता है।",
      "formula": "SR = (Rp - Rf) / σp",
      "interpretation": "> 1: अच्छा, > 2: उत्कृष्ट, < 1: खराब"
    },
    "profitFactor": {
      "term": "प्रॉफिट फैक्टर",
      "definition": "सकल लाभ का सकल हानि से अनुपात। समग्र लाभदायकता दर्शाता है।",
      "formula": "PF = सकल लाभ / सकल हानि",
      "interpretation": "> 1.5: अच्छा, > 2: उत्कृष्ट"
    },
    "maxDrawdown": {
      "term": "अधिकतम ड्रॉडाउन (MDD)",
      "definition": "इक्विटी कर्व में शिखर से निम्नतम तक सबसे बड़ी गिरावट।",
      "formula": "MDD = (शिखर - निम्न) / शिखर × 100%",
      "interpretation": "कम बेहतर है। < 20% स्वीकार्य है"
    },
    "winRate": {
      "term": "जीत दर",
      "definition": "लाभदायक ट्रेड का प्रतिशत।",
      "formula": "WR = लाभदायक ट्रेड / कुल ट्रेड × 100%",
      "interpretation": "> 50% सकारात्मक जोखिम-रिटर्न के साथ लाभदायक है"
    },
    "calmarRatio": {
      "term": "कैल्मार अनुपात",
      "definition": "वार्षिक रिटर्न की अधिकतम ड्रॉडाउन से तुलना करने वाला जोखिम-समायोजित रिटर्न मेट्रिक।",
      "formula": "CR = वार्षिक रिटर्न / |MDD|",
      "interpretation": "> 1: अच्छा, > 3: उत्कृष्ट"
    },
    "sortinoRatio": {
      "term": "सोर्टिनो अनुपात",
      "definition": "शार्प अनुपात के समान लेकिन केवल नीचे की अस्थिरता को ध्यान में रखता है।",
      "formula": "SoR = (Rp - Rf) / σd",
      "interpretation": "उच्चतर बेहतर है। डाउनसाइड डेविएशन का उपयोग करता है"
    },
    "alpha": {
      "term": "अल्फा",
      "definition": "बेंचमार्क इंडेक्स के सापेक्ष निवेश का अतिरिक्त रिटर्न।",
      "formula": "α = Rp - [Rf + β(Rm - Rf)]",
      "interpretation": "सकारात्मक अल्फा प्रदर्शन के ऊपर होने का संकेत देता है"
    },
    "beta": {
      "term": "बीटा",
      "definition": "बाजार के सापेक्ष अस्थिरता का माप।",
      "formula": "β = Cov(Ri, Rm) / Var(Rm)",
      "interpretation": "β > 1: अधिक अस्थिर, < 1: कम अस्थिर"
    },
    "volatility": {
      "term": "वोलैटिलिटी",
      "definition": "रिटर्न के वितरण का सांख्यिकीय माप।",
      "formula": "σ = √(Σ(ri - r̄)² / (n-1))",
      "interpretation": "उच्च वोलैटिलिटी = उच्च जोखिम"
    },
    "informationRatio": {
      "term": "इंफॉर्मेशन अनुपात",
      "definition": "जोखिम-समायोजित रिटर्न को बेंचमार्क के सापेक्ष मापता है।",
      "formula": "IR = (Rp - Rb) / ट्रैकिंग एरर",
      "interpretation": "> 0.5: अच्छा, > 1: उत्कृष्ट"
    }
  }
}
