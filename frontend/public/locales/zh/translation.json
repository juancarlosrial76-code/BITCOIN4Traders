  "glossary": {
    "sharpeRatio": {
      "term": "夏普比率",
      "definition": "衡量风险调整后的收益。计算公式为：(收益 - 无风险利率) / 收益标准差。",
      "formula": "SR = (Rp - Rf) / σp",
      "interpretation": "> 1: 良好, > 2: 优秀, < 1: 较差"
    },
    "profitFactor": {
      "term": "盈利因子",
      "definition": "总盈利与总亏损的比率。显示整体盈利能力。",
      "formula": "PF = 总盈利 / 总亏损",
      "interpretation": "> 1.5: 良好, > 2: 优秀"
    },
    "maxDrawdown": {
      "term": "最大回撤 (MDD)",
      "definition": "权益曲线上从峰值到谷值的最大下降。",
      "formula": "MDD = (峰值 - 谷值) / 峰值 × 100%",
      "interpretation": "越低越好。< 20% 可接受"
    },
    "winRate": {
      "term": "胜率",
      "definition": "盈利交易占总交易数的百分比。",
      "formula": "WR = 盈利交易数 / 总交易数 × 100%",
      "interpretation": "> 50% 且风险收益比为正则盈利"
    },
    "calmarRatio": {
      "term": "卡尔马比率",
      "definition": "风险调整收益指标，将年化收益与最大回撤进行比较。",
      "formula": "CR = 年化收益 / |MDD|",
      "interpretation": "> 1: 良好, > 3: 优秀"
    },
    "sortinoRatio": {
      "term": "索提诺比率",
      "definition": "类似于夏普比率，但仅考虑下行波动性。",
      "formula": "SoR = (Rp - Rf) / σd",
      "interpretation": "越高越好。使用下行标准差"
    },
    "alpha": {
      "term": "阿尔法",
      "definition": "投资的超额收益相对于基准指数。",
      "formula": "α = Rp - [Rf + β(Rm - Rf)]",
      "interpretation": "正阿尔法表示表现优于市场"
    },
    "beta": {
      "term": "贝塔",
      "definition": "相对于市场的波动性度量。",
      "formula": "β = Cov(Ri, Rm) / Var(Rm)",
      "interpretation": "β > 1: 波动更大, < 1: 波动更小"
    },
    "volatility": {
      "term": "波动率",
      "definition": "收益离散度的统计度量。",
      "formula": "σ = √(Σ(ri - r̄)² / (n-1))",
      "interpretation": "波动率越高 = 风险越高"
    },
    "informationRatio": {
      "term": "信息比率",
      "definition": "相对于基准的风险调整收益。",
      "formula": "IR = (Rp - Rb) / 跟踪误差",
      "interpretation": "> 0.5: 良好, > 1: 优秀"
    }
  }
}
