  "glossary": {
    "sharpeRatio": {
      "term": "نسبة شارب",
      "definition": "تقيس العائد المعدل حسب المخاطر. تحسب كـ (العائد - معدل بدون مخاطر) / الانحراف المعياري للعوائد.",
      "formula": "SR = (Rp - Rf) / σp",
      "interpretation": "> 1: جيد, > 2: ممتاز, < 1: ضعيف"
    },
    "profitFactor": {
      "term": "عامل الربح",
      "definition": "نسبة الربح الإجمالي إلى الخسارة الإجمالية. يُظهر الربحية الشاملة.",
      "formula": "PF = الربح الإجمالي / الخسارة الإجمالية",
      "interpretation": "> 1.5: جيد, > 2: ممتاز"
    },
    "maxDrawdown": {
      "term": "أقصى انخفاض (MDD)",
      "definition": "أكبر انخفاض من الذروة إلى القاع في منحنى حقوق الملكية.",
      "formula": "MDD = (الذروة - القاع) / الذروة × 100%",
      "interpretation": "كلما كان أقل كان أفضل. < 20% مقبول"
    },
    "winRate": {
      "term": "معدل الفوز",
      "definition": "النسبة المئوية للصفقات المربحة.",
      "formula": "WR = صفقات رابحة / إجمالي الصفقات × 100%",
      "interpretation": "> 50% مع مخاطرة-عائد إيجابي مربح"
    },
    "calmarRatio": {
      "term": "نسبة كالمار",
      "definition": "مقياس العائد المعدل حسب المخاطر يقارن العائد السنوي مع أقصى انخفاض.",
      "formula": "CR = العائد السنوي / |MDD|",
      "interpretation": "> 1: جيد, > 3: ممتاز"
    },
    "sortinoRatio": {
      "term": "نسبة سورتينو",
      "definition": "مشابه لنسبة شارب لكنه يأخذ في الاعتبار التقلب الهبوطي فقط.",
      "formula": "SoR = (Rp - Rf) / σd",
      "interpretation": "كلما كان أعلى كان أفضل. يستخدم الانحراف الهبوطي"
    },
    "alpha": {
      "term": "ألفا",
      "definition": "العائد الزائد للاستثمار بالنسبة لمؤشر مرجعي.",
      "formula": "α = Rp - [Rf + β(Rm - Rf)]",
      "interpretation": "ألفا إيجابي يشير إلى تفوق في الأداء"
    },
    "beta": {
      "term": "بيتا",
      "definition": "مقياس التقلب بالنسبة للسوق.",
      "formula": "β = Cov(Ri, Rm) / Var(Rm)",
      "interpretation": "β > 1: أكثر تقلباً, < 1: أقل تقلباً"
    },
    "volatility": {
      "term": "التقلب",
      "definition": "مقياس إحصائي لتشتت العوائد.",
      "formula": "σ = √(Σ(ri - r̄)² / (n-1))",
      "interpretation": "ارتفاع التقلب يعني ارتفاع المخاطر"
    },
    "informationRatio": {
      "term": "نسبة المعلومات",
      "definition": "يقيس العوائد المعدلة حسب المخاطر بالنسبة لمرجع.",
      "formula": "IR = (Rp - Rb) / خطأ التتبع",
      "interpretation": "> 0.5: جيد, > 1: ممتاز"
    }
  }
}
