  "glossary": {
    "sharpeRatio": {
      "term": "Rasio Sharpe",
      "definition": "Ukuran return yang disesuaikan dengan risiko. Dihitung sebagai (Return - Risk-Free Rate) / Standar Deviasi Return.",
      "formula": "SR = (Rp - Rf) / σp",
      "interpretation": "> 1: Baik, > 2: Excellent, < 1: Buruk"
    },
    "profitFactor": {
      "term": "Faktor Profit",
      "definition": "Rasio profit kotor terhadap kerugian kotor. Menunjukkan profitabilitas keseluruhan.",
      "formula": "PF = Profit Kotor / Kerugian Kotor",
      "interpretation": "> 1.5: Baik, > 2: Excellent"
    },
    "maxDrawdown": {
      "term": "Drawdown Maksimum (MDD)",
      "definition": "Penurunan puncak-ke-terendah terbesar dalam kurva ekuitas.",
      "formula": "MDD = (Puncak - Terendah) / Puncak × 100%",
      "interpretation": "Lebih rendah lebih baik. < 20% dapat diterima"
    },
    "winRate": {
      "term": "Tingkat Kemenangan",
      "definition": "Persentase trading yang profitable.",
      "formula": "WR = Trading Menang / Total Trading × 100%",
      "interpretation": "> 50% dengan risk-reward positif adalah profitable"
    },
    "calmarRatio": {
      "term": "Rasio Calmar",
      "definition": "Metrik return yang disesuaikan dengan risiko membandingkan return tahunan dengan drawdown maksimum.",
      "formula": "CR = Return Tahunan / |MDD|",
      "interpretation": "> 1: Baik, > 3: Excellent"
    },
    "sortinoRatio": {
      "term": "Rasio Sortino",
      "definition": "Mirip dengan Rasio Sharpe tetapi hanya mempertimbangkan volatilitas ke bawah.",
      "formula": "SoR = (Rp - Rf) / σd",
      "interpretation": "Lebih tinggi lebih baik. Menggunakan downside deviation"
    },
    "alpha": {
      "term": "Alpha",
      "definition": "Return berlebih dari investasi relatif terhadap indeks benchmark.",
      "formula": "α = Rp - [Rf + β(Rm - Rf)]",
      "interpretation": "Alpha positif menunjukkan outperformance"
    },
    "beta": {
      "term": "Beta",
      "definition": "Ukuran volatilitas relatif terhadap pasar.",
      "formula": "β = Cov(Ri, Rm) / Var(Rm)",
      "interpretation": "β > 1: Lebih volatil, < 1: Kurang volatil"
    },
    "volatility": {
      "term": "Volatilitas",
      "definition": "Ukuran statistik dispersi return.",
      "formula": "σ = √(Σ(ri - r̄)² / (n-1))",
      "interpretation": "Volatilitas tinggi berarti risiko tinggi"
    },
    "informationRatio": {
      "term": "Rasio Informasi",
      "definition": "Mengukur return yang disesuaikan dengan risiko relatif terhadap benchmark.",
      "formula": "IR = (Rp - Rb) / Tracking Error",
      "interpretation": "> 0.5: Baik, > 1: Excellent"
    }
  }
}
