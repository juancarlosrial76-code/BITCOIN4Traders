  "glossary": {
    "sharpeRatio": {
      "term": "샤프 비율",
      "definition": "리스크 조정 수익을 측정합니다. 계산 공식: (수익 - 무리스크 이자) / 수익의 표준 편차",
      "formula": "SR = (Rp - Rf) / σp",
      "interpretation": "> 1:良好, > 2:優秀, < 1:불량"
    },
    "profitFactor": {
      "term": "프로팩터",
      "definition": "총 이익 대 총 손실의 비율. 전반적인 수익성 표시",
      "formula": "PF = 총 이익 / 총 손실",
      "interpretation": "> 1.5:良好, > 2:優秀"
    },
    "maxDrawdown": {
      "term": "최대 드로다운 (MDD)",
      "definition": "Equity 곡선에서 피크에서 트러프까지의 가장 큰 하락",
      "formula": "MDD = (피크 - 트러프) / 피크 × 100%",
      "interpretation": "낮을수록 좋습니다. < 20%는 허용 가능"
    },
    "winRate": {
      "term": "승률",
      "definition": "수익 트레이드의百分比",
      "formula": "WR = 승리 트레이드 / 전체 트레이드 × 100%",
      "interpretation": "> 50%는 양의 리스크-수익比为 수익성 있음"
    },
    "calmarRatio": {
      "term": "칼마 비율",
      "definition": "연간 수익률과 최대 드로다운을 비교하는 리스크 조정 수익 지표",
      "formula": "CR = 연간 수익률 / |MDD|",
      "interpretation": "> 1:良好, > 3:優秀"
    },
    "sortinoRatio": {
      "term": "소르티노 비율",
      "definition": "샤프 비율과 유사하지만 하락 변동성만 고려",
      "formula": "SoR = (Rp - Rf) / σd",
      "interpretation": "높을수록 좋습니다. 하락 편차 사용"
    },
    "alpha": {
      "term": "알파",
      "definition": "벤치마크 지수에 대한 투자의 초과 수익",
      "formula": "α = Rp - [Rf + β(Rm - Rf)]",
      "interpretation": "양의 알파는 아웃퍼포먼스를 나타냄"
    },
    "beta": {
      "term": "베타",
      "definition": "시장에 대한 변동성 측정",
      "formula": "β = Cov(Ri, Rm) / Var(Rm)",
      "interpretation": "β > 1: 더 변동적, < 1: 덜 변동적"
    },
    "volatility": {
      "term": "변동성",
      "definition": "수익의 분산도에 대한 통계적 측정",
      "formula": "σ = √(Σ(ri - r̄)² / (n-1))",
      "interpretation": "높은 변동성 = 높은 리스크"
    },
    "informationRatio": {
      "term": "인포메이션 비율",
      "definition": "벤치마크에 대한 리스크 조정 수익 측정",
      "formula": "IR = (Rp - Rb) / 추적 오류",
      "interpretation": "> 0.5:良好, > 1:優秀"
    }
  }
}
