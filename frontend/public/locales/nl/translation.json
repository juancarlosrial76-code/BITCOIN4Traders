  "glossary": {
    "sharpeRatio": {
      "term": "Sharpe ratio",
      "definition": "Meet het risico-gecorrigeerde rendement. Berekend als (Rendement - Risicovrije rente) / Standaardafwijking.",
      "formula": "SR = (Rp - Rf) / σp",
      "interpretation": "> 1: Goed, > 2: Uitstekend, < 1: Slecht"
    },
    "profitFactor": {
      "term": "Winstfactor",
      "definition": "Verhouding van bruto winst tot bruto verlies. Toont algehele winstgevendheid.",
      "formula": "PF = Bruto Winst / Bruto Verlies",
      "interpretation": "> 1.5: Goed, > 2: Uitstekend"
    },
    "maxDrawdown": {
      "term": "Maximale Drawdown (MDD)",
      "definition": "De grootste daling van piek tot dal in de equity curve.",
      "formula": "MDD = (Piek - Dal) / Piek × 100%",
      "interpretation": "Lager is beter. < 20% is acceptabel"
    },
    "winRate": {
      "term": "Winpercentage",
      "definition": "Percentage winstgevende trades.",
      "formula": "WR = Winnende Trades / Totaal Trades × 100%",
      "interpretation": "> 50% met positief risico-rendement is winstgevend"
    },
    "calmarRatio": {
      "term": "Calmar ratio",
      "definition": "Risico-gecorrigeerde rendementsmetriek die jaarvergoeding vergelijkt met maximale drawdown.",
      "formula": "CR = Jaarlijks Rendement / |MDD|",
      "interpretation": "> 1: Goed, > 3: Uitstekend"
    },
    "sortinoRatio": {
      "term": "Sortino ratio",
      "definition": "Vergelijkbaar met Sharpe ratio maar beschouwt alleen neerwaartse volatiliteit.",
      "formula": "SoR = (Rp - Rf) / σd",
      "interpretation": "Hoger is beter. Gebruikt neerwaartse afwijking"
    },
    "alpha": {
      "term": "Alpha",
      "definition": "Extra rendement van een belegging ten opzichte van een benchmark index.",
      "formula": "α = Rp - [Rf + β(Rm - Rf)]",
      "interpretation": "Positieve alpha geeft outperformance aan"
    },
    "beta": {
      "term": "Beta",
      "definition": "Maatstaf voor volatiliteit ten opzichte van de markt.",
      "formula": "β = Cov(Ri, Rm) / Var(Rm)",
      "interpretation": "β > 1: Meer volatiel, < 1: Minder volatiel"
    },
    "volatility": {
      "term": "Volatiliteit",
      "definition": "Statistische maatstaf voor de spreiding van rendementen.",
      "formula": "σ = √(Σ(ri - r̄)² / (n-1))",
      "interpretation": "Hogere volatiliteit betekent hoger risico"
    },
    "informationRatio": {
      "term": "Informatie ratio",
      "definition": "Meet risico-gecorrigeerde rendementen ten opzichte van een benchmark.",
      "formula": "IR = (Rp - Rb) / Tracking Error",
      "interpretation": "> 0.5: Goed, > 1: Uitstekend"
    }
  }
}
