  "glossary": {
    "sharpeRatio": {
      "term": "Índice de Sharpe",
      "definition": "Mede o retorno ajustado ao risco. Calculado como (Retorno - Taxa Sem Risco) / Desvio Padrão dos retornos.",
      "formula": "SR = (Rp - Rf) / σp",
      "interpretation": "> 1: Bom, > 2: Excelente, < 1: Ruim"
    },
    "profitFactor": {
      "term": "Fator de Lucro",
      "definition": "Proporção de lucro bruto para perda bruta. Mostra lucratividade geral.",
      "formula": "PF = Lucro Bruto / Perda Bruta",
      "interpretation": "> 1.5: Bom, > 2: Excelente"
    },
    "maxDrawdown": {
      "term": "Drawdown Máximo (MDD)",
      "definition": "A maior queda do pico ao vale na curva de capital.",
      "formula": "MDD = (Pico - Vale) / Pico × 100%",
      "interpretation": "Menor é melhor. < 20% é aceitável"
    },
    "winRate": {
      "term": "Taxa de Acerto",
      "definition": "Porcentagem de trades lucrativos.",
      "formula": "WR = Trades Vencedores / Total de Trades × 100%",
      "interpretation": "> 50% com risco-retorno positivo é lucrativo"
    },
    "calmarRatio": {
      "term": "Índice de Calmar",
      "definition": "Métrica de retorno ajustado ao risco comparando retorno anualizado com drawdown máximo.",
      "formula": "CR = Retorno Anualizado / |MDD|",
      "interpretation": "> 1: Bom, > 3: Excelente"
    },
    "sortinoRatio": {
      "term": "Índice de Sortino",
      "definition": "Semelhante ao Índice de Sharpe mas considera apenas a volatilidade de baixa.",
      "formula": "SoR = (Rp - Rf) / σd",
      "interpretation": "Maior é melhor. Usa desvio de baixa"
    },
    "alpha": {
      "term": "Alpha",
      "definition": "Retorno excedente de um investimento relativo a um índice de referência.",
      "formula": "α = Rp - [Rf + β(Rm - Rf)]",
      "interpretation": "Alpha positivo indica bom desempenho"
    },
    "beta": {
      "term": "Beta",
      "definition": "Medida de volatilidade relativa ao mercado.",
      "formula": "β = Cov(Ri, Rm) / Var(Rm)",
      "interpretation": "β > 1: Mais volátil, < 1: Menos volátil"
    },
    "volatility": {
      "term": "Volatilidade",
      "definition": "Medida estatística da dispersão dos retornos.",
      "formula": "σ = √(Σ(ri - r̄)² / (n-1))",
      "interpretation": "Maior volatilidade significa maior risco"
    },
    "informationRatio": {
      "term": "Índice de Informação",
      "definition": "Mede retornos ajustados ao risco relativos a uma referência.",
      "formula": "IR = (Rp - Rb) / Erro de Tracking",
      "interpretation": "> 0.5: Bom, > 1: Excelente"
    }
  }
}
