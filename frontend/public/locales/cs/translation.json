  "glossary": {
    "sharpeRatio": {
      "term": "Sharpe Ratio",
      "definition": "A measure of risk-adjusted return. Calculated as (Return - Risk-Free Rate) / Standard Deviation of Returns.",
      "formula": "SR = (Rp - Rf) / σp",
      "interpretation": "> 1: Good, > 2: Excellent, < 1: Poor"
    },
    "profitFactor": {
      "term": "Profit Factor",
      "definition": "Ratio of gross profit to gross loss. Shows overall profitability.",
      "formula": "PF = Gross Profit / Gross Loss",
      "interpretation": "> 1.5: Good, > 2: Excellent"
    },
    "maxDrawdown": {
      "term": "Maximum Drawdown (MDD)",
      "definition": "The largest peak-to-trough decline in the equity curve.",
      "formula": "MDD = (Peak - Trough) / Peak × 100%",
      "interpretation": "Lower is better. < 20% is acceptable"
    },
    "winRate": {
      "term": "Win Rate",
      "definition": "Percentage of trades that are profitable.",
      "formula": "WR = Winning Trades / Total Trades × 100%",
      "interpretation": "> 50% with positive risk-reward is profitable"
    },
    "calmarRatio": {
      "term": "Calmar Ratio",
      "definition": "Risk-adjusted return metric comparing annualized return to maximum drawdown.",
      "formula": "CR = Annualized Return / |MDD|",
      "interpretation": "> 1: Good, > 3: Excellent"
    },
    "sortinoRatio": {
      "term": "Sortino Ratio",
      "definition": "Similar to Sharpe Ratio but only considers downside volatility.",
      "formula": "SoR = (Rp - Rf) / σd",
      "interpretation": "Higher is better. Uses downside deviation"
    },
    "alpha": {
      "term": "Alpha",
      "definition": "Excess return of an investment relative to a benchmark index.",
      "formula": "α = Rp - [Rf + β(Rm - Rf)]",
      "interpretation": "Positive alpha indicates outperformance"
    },
    "beta": {
      "term": "Beta",
      "definition": "Measure of volatility relative to the market.",
      "formula": "β = Cov(Ri, Rm) / Var(Rm)",
      "interpretation": "β > 1: More volatile, < 1: Less volatile"
    },
    "volatility": {
      "term": "Volatility",
      "definition": "Statistical measure of the dispersion of returns.",
      "formula": "σ = √(Σ(ri - r̄)² / (n-1))",
      "interpretation": "Higher volatility means higher risk"
    },
    "informationRatio": {
      "term": "Information Ratio",
      "definition": "Measures risk-adjusted returns relative to a benchmark.",
      "formula": "IR = (Rp - Rb) / Tracking Error",
      "interpretation": "> 0.5: Good, > 1: Excellent"
    }
  }
}
