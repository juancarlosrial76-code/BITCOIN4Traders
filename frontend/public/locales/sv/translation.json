  "glossary": {
    "sharpeRatio": {
      "term": "Sharpe-kvot",
      "definition": "Ett mått på riskjusterad avkastning. Beräknas som (Avkastning - Riskfri ränta) / Standardavvikelse för avkastning.",
      "formula": "SR = (Rp - Rf) / σp",
      "interpretation": "> 1: Bra, > 2: Utmärkt, < 1: Dålig"
    },
    "profitFactor": {
      "term": "Vinstfaktor",
      "definition": "Förhållandet mellan bruttovinst och bruttoförlust. Visar total lönsamhet.",
      "formula": "PF = Bruttovinst / Bruttoförlust",
      "interpretation": "> 1.5: Bra, > 2: Utmärkt"
    },
    "maxDrawdown": {
      "term": "Maximal Drawdown (MDD)",
      "definition": "Den största topp-till-dal-minskningen i kapitalkurvan.",
      "formula": "MDD = (Topp - Dal) / Topp × 100%",
      "interpretation": "Lägre är bättre. < 20% är acceptabelt"
    },
    "winRate": {
      "term": "Vinstfrekvens",
      "definition": "Procentandelen lönsamma affärer.",
      "formula": "WR = Vinnande affärer / Totala affärer × 100%",
      "interpretation": "> 50% med positiv risk-avkastning är lönsamt"
    },
    "calmarRatio": {
      "term": "Calmar-kvot",
      "definition": "Riskjusterad avkastningsmått som jämför årlig avkastning med maximal drawdown.",
      "formula": "CR = Årlig avkastning / |MDD|",
      "interpretation": "> 1: Bra, > 3: Utmärkt"
    },
    "sortinoRatio": {
      "term": "Sortino-kvot",
      "definition": "Liknande Sharpe-kvot men tar endast hänsyn till nedsidenvolatilitet.",
      "formula": "SoR = (Rp - Rf) / σd",
      "interpretation": "Högre är bättre. Använder nedsidesavvikelse"
    },
    "alpha": {
      "term": "Alfa",
      "definition": "Överavkastning av en investering relativt ett benchmark-index.",
      "formula": "α = Rp - [Rf + β(Rm - Rf)]",
      "interpretation": "Positiv alfa indikerar överavkastning"
    },
    "beta": {
      "term": "Beta",
      "definition": "Mått på volatilitet relativt marknaden.",
      "formula": "β = Cov(Ri, Rm) / Var(Rm)",
      "interpretation": "β > 1: Mer volatil, < 1: Mindre volatil"
    },
    "volatility": {
      "term": "Volatilitet",
      "definition": "Statistiskt mått på spridningen av avkastning.",
      "formula": "σ = √(Σ(ri - r̄)² / (n-1))",
      "interpretation": "Hög volatilitet innebär hög risk"
    },
    "informationRatio": {
      "term": "Informationskvot",
      "definition": "Mäter riskjusterad avkastning relativt en benchmark.",
      "formula": "IR = (Rp - Rb) / Tracking Error",
      "interpretation": "> 0.5: Bra, > 1: Utmärkt"
    }
  }
}
