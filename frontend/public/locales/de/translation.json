  "glossary": {
    "sharpeRatio": {
      "term": "Sharpe-Ratio",
      "definition": "Ein Maß für die risikoadjustierte Rendite. Berechnet als (Rendite - Risikofreier Zins) / Standardabweichung der Renditen.",
      "formula": "SR = (Rp - Rf) / σp",
      "interpretation": "> 1: Gut, > 2: Ausgezeichnet, < 1: Schlecht"
    },
    "profitFactor": {
      "term": "Gewinnfaktor",
      "definition": "Verhältnis von Bruttogewinn zu Bruttoverlust. Zeigt die Gesamtrentabilität.",
      "formula": "PF = Bruttogewinn / Bruttoverlust",
      "interpretation": "> 1,5: Gut, > 2: Ausgezeichnet"
    },
    "maxDrawdown": {
      "term": "Maximaler Drawdown (MDD)",
      "definition": "Der größte Peak-to-Trough-Rückgang in der Equity-Kurve.",
      "formula": "MDD = (Peak - Trough) / Peak × 100%",
      "interpretation": "Niedriger ist besser. < 20% ist akzeptabel"
    },
    "winRate": {
      "term": "Gewinnrate",
      "definition": "Prozentsatz der profitablen Trades.",
      "formula": "WR = Gewinntrades / Gesamttrades × 100%",
      "interpretation": "> 50% mit positivem Risiko-Ertrag ist profitabel"
    },
    "calmarRatio": {
      "term": "Calmar-Ratio",
      "definition": "Risikoadjustierte Renditekennzahl, die annualisierte Rendite mit maximalem Drawdown vergleicht.",
      "formula": "CR = Annualisierte Rendite / |MDD|",
      "interpretation": "> 1: Gut, > 3: Ausgezeichnet"
    },
    "sortinoRatio": {
      "term": "Sortino-Ratio",
      "definition": "Ähnlich wie Sharpe-Ratio, berücksichtigt aber nur die Abwärtsvolatilität.",
      "formula": "SoR = (Rp - Rf) / σd",
      "interpretation": "Je höher, desto besser. Verwendet Abweichung nach unten"
    },
    "alpha": {
      "term": "Alpha",
      "definition": "Überrendite einer Anlage relativ zu einem Benchmark-Index.",
      "formula": "α = Rp - [Rf + β(Rm - Rf)]",
      "interpretation": "Positives Alpha zeigt Outperformance"
    },
    "beta": {
      "term": "Beta",
      "definition": "Maß für die Volatilität relativ zum Markt.",
      "formula": "β = Cov(Ri, Rm) / Var(Rm)",
      "interpretation": "β > 1: Volatiler, < 1: Weniger volatil"
    },
    "volatility": {
      "term": "Volatilität",
      "definition": "Statistisches Maß für die Streuung der Renditen.",
      "formula": "σ = √(Σ(ri - r̄)² / (n-1))",
      "interpretation": "Höhere Volatilität bedeutet höheres Risiko"
    },
    "informationRatio": {
      "term": "Information-Ratio",
      "definition": "Misst risikoadjustierte Renditen relativ zu einer Benchmark.",
      "formula": "IR = (Rp - Rb) / Tracking Error",
      "interpretation": "> 0,5: Gut, > 1: Ausgezeichnet"
    }
  }
}
