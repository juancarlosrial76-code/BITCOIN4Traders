  "glossary": {
    "sharpeRatio": {
      "term": "Sharpe-forhold",
      "definition": "Et mål på risikojustert avkastning. Beregnet som (Avkastning - Risikofri rente) / Standardavvik for avkastning.",
      "formula": "SR = (Rp - Rf) / σp",
      "interpretation": "> 1: God, > 2: Utmerket, < 1: Dårlig"
    },
    "profitFactor": {
      "term": "Fortjenestefaktor",
      "definition": "Forholdet mellom bruttofortjeneste og brutto tap. Viser total lønnsomhet.",
      "formula": "PF = Bruttofortjeneste / Brutto tap",
      "interpretation": "> 1.5: God, > 2: Utmerket"
    },
    "maxDrawdown": {
      "term": "Maksimal Drawdown (MDD)",
      "definition": "Det største topp-til-bunn fallet i egenkapital kurven.",
      "formula": "MDD = (Topp - Bunn) / Topp × 100%",
      "interpretation": "Lavere er bedre. < 20% er akseptabelt"
    },
    "winRate": {
      "term": "Vinnrate",
      "definition": "Prosentandelen av handler som er lønnsomme.",
      "formula": "WR = Vinnende handler / Totale handler × 100%",
      "interpretation": "> 50% med positiv risiko-belønning er lønnsomt"
    },
    "calmarRatio": {
      "term": "Calmar-forhold",
      "definition": "Risikojustert avkastningsmåling som sammenligner årlig avkastning med maksimal drawdown.",
      "formula": "CR = Årlig avkastning / |MDD|",
      "interpretation": "> 1: God, > 3: Utmerket"
    },
    "sortinoRatio": {
      "term": "Sortino-forhold",
      "definition": "Ligner på Sharpe-forhold men vurderer kun nedadgående volatilitet.",
      "formula": "SoR = (Rp - Rf) / σd",
      "interpretation": "Høyere er bedre. Bruker nedadgående avvik"
    },
    "alpha": {
      "term": "Alfa",
      "definition": "Meravkastning av en investering relativt til en referanseindeks.",
      "formula": "α = Rp - [Rf + β(Rm - Rf)]",
      "interpretation": "Positiv alfa indikerer overytelse"
    },
    "beta": {
      "term": "Beta",
      "definition": "Mål på volatilitet relativt til markedet.",
      "formula": "β = Cov(Ri, Rm) / Var(Rm)",
      "interpretation": "β > 1: Mer volatil, < 1: Mindre volatil"
    },
    "volatility": {
      "term": "Volatilitet",
      "definition": "Statistisk mål på spredningen av avkastning.",
      "formula": "σ = √(Σ(ri - r̄)² / (n-1))",
      "interpretation": "Høy volatilitet betyr høy risiko"
    },
    "informationRatio": {
      "term": "Informasjonsforhold",
      "definition": "Måler risikojustert avkastning relativt til en referanse.",
      "formula": "IR = (Rp - Rb) / Sporingsfeil",
      "interpretation": "> 0.5: God, > 1: Utmerket"
    }
  }
}
