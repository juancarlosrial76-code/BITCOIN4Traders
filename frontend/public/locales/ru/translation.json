  "glossary": {
    "sharpeRatio": {
      "term": "Коэффициент Шарпа",
      "definition": "Измеряет доходность с поправкой на риск. Рассчитывается как (Доходность - Безрисковая ставка) / Стандартное отклонение.",
      "formula": "SR = (Rp - Rf) / σp",
      "interpretation": "> 1: Хороший, > 2: Отличный, < 1: Плохой"
    },
    "profitFactor": {
      "term": "Фактор прибыли",
      "definition": "Отношение валовой прибыли к валовому убытку. Показывает общую прибыльность.",
      "formula": "PF = Валовая прибыль / Валовый убыток",
      "interpretation": "> 1.5: Хороший, > 2: Отличный"
    },
    "maxDrawdown": {
      "term": "Максимальная просадка (MDD)",
      "definition": "Наибольшее падение от пика до минимума на кривой капитала.",
      "formula": "MDD = (Пик - Минимум) / Пик × 100%",
      "interpretation": "Чем меньше, тем лучше. < 20% приемлемо"
    },
    "winRate": {
      "term": "Процент выигрышей",
      "definition": "Процент прибыльных сделок.",
      "formula": "WR = Прибыльные сделки / Всего сделок × 100%",
      "interpretation": "> 50% с положительным соотношением риск-прибыль прибыльно"
    },
    "calmarRatio": {
      "term": "Коэффициент Кальмара",
      "definition": "Метрика доходности с поправкой на риск, сравнивающая годовую доходность с максимальной просадкой.",
      "formula": "CR = Годовая доходность / |MDD|",
      "interpretation": "> 1: Хороший, > 3: Отличный"
    },
    "sortinoRatio": {
      "term": "Коэффициент Сортино",
      "definition": "Похож на коэффициент Шарпа, но учитывает только нисходящую волатильность.",
      "formula": "SoR = (Rp - Rf) / σd",
      "interpretation": "Чем выше, тем лучше. Использует нижнее отклонение"
    },
    "alpha": {
      "term": "Альфа",
      "definition": "Избыточная доходность инвестиции относительно индекса бенчмарка.",
      "formula": "α = Rp - [Rf + β(Rm - Rf)]",
      "interpretation": "Положительная альфа указывает на превосходную производительность"
    },
    "beta": {
      "term": "Бета",
      "definition": "Мера волатильности относительно рынка.",
      "formula": "β = Cov(Ri, Rm) / Var(Rm)",
      "interpretation": "β > 1: Более волатильная, < 1: Менее волатильная"
    },
    "volatility": {
      "term": "Волатильность",
      "definition": "Статистическая мера разброса доходностей.",
      "formula": "σ = √(Σ(ri - r̄)² / (n-1))",
      "interpretation": "Высокая волатильность означает высокий риск"
    },
    "informationRatio": {
      "term": "Коэффициент информации",
      "definition": "Измеряет доходность с поправкой на риск относительно бенчмарка.",
      "formula": "IR = (Rp - Rb) / Ошибка слежения",
      "interpretation": "> 0.5: Хороший, > 1: Отличный"
    }
  }
}
