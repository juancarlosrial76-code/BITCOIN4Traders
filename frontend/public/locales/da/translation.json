  "glossary": {
    "sharpeRatio": {
      "term": "Sharpe-ratio",
      "definition": "Et mål for risikojusteret afkast. Beregnet som (Afkast - Risikofri rente) / Standardafvigelse af afkast.",
      "formula": "SR = (Rp - Rf) / σp",
      "interpretation": "> 1: God, > 2: Fremragende, < 1: Dårlig"
    },
    "profitFactor": {
      "term": "Profitfaktor",
      "definition": "Forholdet mellem bruttofortjeneste og bruttotab. Viser samlet rentabilitet.",
      "formula": "PF = Bruttofortjeneste / Bruttotab",
      "interpretation": "> 1.5: God, > 2: Fremragende"
    },
    "maxDrawdown": {
      "term": "Maksimal Drawdown (MDD)",
      "definition": "Det største fald fra top til bund i egenkapitalkurven.",
      "formula": "MDD = (Top - Bund) / Top × 100%",
      "interpretation": "Lavere er bedre. < 20% er acceptabelt"
    },
    "winRate": {
      "term": "Gevinstrate",
      "definition": "Procentdelen af handler, der er profitable.",
      "formula": "WR = Vindende handler / Samlede handler × 100%",
      "interpretation": "> 50% med positiv risiko-afkast er profitabelt"
    },
    "calmarRatio": {
      "term": "Calmar-ratio",
      "definition": "Risikojusteret afkastmåling, der sammenligner årligt afkast med maksimal drawdown.",
      "formula": "CR = Årligt afkast / |MDD|",
      "interpretation": "> 1: God, > 3: Fremragende"
    },
    "sortinoRatio": {
      "term": "Sortino-ratio",
      "definition": "Ligner Sharpe-ratio men overvejer kun nedadgående volatilitet.",
      "formula": "SoR = (Rp - Rf) / σd",
      "interpretation": "Højere er bedre. Bruger nedadgående afvigelse"
    },
    "alpha": {
      "term": "Alfa",
      "definition": "Merafkast af en investering i forhold til et benchmark-indeks.",
      "formula": "α = Rp - [Rf + β(Rm - Rf)]",
      "interpretation": "Positiv alfa indikerer outperformance"
    },
    "beta": {
      "term": "Beta",
      "definition": "Mål for volatilitet i forhold til markedet.",
      "formula": "β = Cov(Ri, Rm) / Var(Rm)",
      "interpretation": "β > 1: Mere volatil, < 1: Mindre volatil"
    },
    "volatility": {
      "term": "Volatilitet",
      "definition": "Statistisk mål for spredningen af afkast.",
      "formula": "σ = √(Σ(ri - r̄)² / (n-1))",
      "interpretation": "Høj volatilitet betyder høj risiko"
    },
    "informationRatio": {
      "term": "Informationsratio",
      "definition": "Måler risikojusteret afkast i forhold til et benchmark.",
      "formula": "IR = (Rp - Rb) / Tracking Error",
      "interpretation": "> 0.5: God, > 1: Fremragende"
    }
  }
}
