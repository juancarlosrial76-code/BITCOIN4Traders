  "glossary": {
    "sharpeRatio": {
      "term": "Ratio de Sharpe",
      "definition": "Mide el retorno ajustado al riesgo. Calculado como (Retorno - Tasa Sin Riesgo) / Desviación Estándar.",
      "formula": "SR = (Rp - Rf) / σp",
      "interpretation": "> 1: Bueno, > 2: Excelente, < 1: Pobre"
    },
    "profitFactor": {
      "term": "Factor de Ganancia",
      "definition": "Ratio de ganancia bruta a pérdida bruta. Muestra rentabilidad general.",
      "formula": "PF = Ganancia Bruta / Pérdida Bruta",
      "interpretation": "> 1.5: Bueno, > 2: Excelente"
    },
    "maxDrawdown": {
      "term": "Drawdown Máximo (MDD)",
      "definition": "La mayor caída de pico a valle en la curva de equidad.",
      "formula": "MDD = (Pico - Valle) / Pico × 100%",
      "interpretation": "Menor es mejor. < 20% es aceptable"
    },
    "winRate": {
      "term": "Tasa de Aciertos",
      "definition": "Porcentaje de trades rentables.",
      "formula": "WR = Trades Ganadores / Total Trades × 100%",
      "interpretation": "> 50% con riesgo-retorno positivo es rentable"
    },
    "calmarRatio": {
      "term": "Ratio de Calmar",
      "definition": "Métrica de retorno ajustado al riesgo comparando retorno anualizado con drawdown máximo.",
      "formula": "CR = Retorno Anualizado / |MDD|",
      "interpretation": "> 1: Bueno, > 3: Excelente"
    },
    "sortinoRatio": {
      "term": "Ratio de Sortino",
      "definition": "Similar al Ratio de Sharpe pero solo considera volatilidad a la baja.",
      "formula": "SoR = (Rp - Rf) / σd",
      "interpretation": "Mayor es mejor. Usa desviación a la baja"
    },
    "alpha": {
      "term": "Alpha",
      "definition": "Retorno excedente relativo a un índice de referencia.",
      "formula": "α = Rp - [Rf + β(Rm - Rf)]",
      "interpretation": "Alpha positivo indica buen rendimiento"
    },
    "beta": {
      "term": "Beta",
      "definition": "Medida de volatilidad relativa al mercado.",
      "formula": "β = Cov(Ri, Rm) / Var(Rm)",
      "interpretation": "β > 1: Más volátil, < 1: Menos volátil"
    },
    "volatility": {
      "term": "Volatilidad",
      "definition": "Medida estadística de la dispersión de retornos.",
      "formula": "σ = √(Σ(ri - r̄)² / (n-1))",
      "interpretation": "Mayor volatilidad significa mayor riesgo"
    },
    "informationRatio": {
      "term": "Ratio de Información",
      "definition": "Mide retornos ajustados al riesgo relativos a una referencia.",
      "formula": "IR = (Rp - Rb) / Error de Seguimiento",
      "interpretation": "> 0.5: Bueno, > 1: Excelente"
    }
  }
}
