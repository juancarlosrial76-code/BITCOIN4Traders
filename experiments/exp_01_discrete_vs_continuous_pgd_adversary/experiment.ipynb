    "\n",
    "import torch\n",
    "\n",
    "# Device\n",
    "DEVICE = 'cuda' if torch.cuda.is_available() else 'cpu'\n",
    "print(f'Device: {DEVICE}')\n",
    "\n",
    "# Experiment settings\n",
    "EXPERIMENT_NAME = 'exp_01_adversary_comparison_v2'\n",
    "N_ITERATIONS = 300          # Training iterations per trader\n",
    "ADVERSARY_START = 50       # When adversary training starts\n",
    "ADVERSARY_STRENGTH = 0.1   # Strength of adversary perturbations\n",
    "\n",
    "# Trader settings (IDENTICAL for all 3)\n",
