    "\n",
    "# Continuous (PGD) specific\n",
    "PGD_EPSILON = 0.02         # 2% max perturbation per feature\n",
    "ACTION_STD_INIT = 0.5\n",
    "\n",
    "print(f'Experiment: {EXPERIMENT_NAME}')\n",
    "print(f'Iterations: {N_ITERATIONS} | Adversary start: {ADVERSARY_START}')\n",
