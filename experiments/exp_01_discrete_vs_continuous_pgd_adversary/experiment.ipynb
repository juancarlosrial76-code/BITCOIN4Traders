    "## Training Function (Supports all 3 approaches)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ═══════════════════════════════════════════════════════════════════════\n",
    "# TRAINING FUNCTION\n",
    "# ═══════════════════════════════════════════════════════════════════════\n",
    "\n",
    "from src.agents.ppo_agent import PPOConfig, PPOAgent\n",
    "from src.training.adversarial_trainer import AdversarialTrainer, AdversarialConfig\n",
    "import time\n",
    "\n",
    "def train_trader(\n",
    "    env,\n",
    "    vec_env,\n",
    "    adversary_type: str,  # 'discrete_4', 'discrete_16', or 'continuous'\n",
    "    n_iterations: int = N_ITERATIONS,\n",
    "    save_dir: str = None\n",
    ") -> dict:\n",
    "    \"\"\"\n",
    "    Train a trader with specified adversary type.\n",
    "    Returns metrics: {iterations: [], profits: [], returns: []}\n",
    "    \"\"\"\n",
    "    \n",
    "    # Create PPO config for trader (identical for all 3)\n",
    "    trader_config = PPOConfig(\n",
    "        state_dim=state_dim,\n",
    "        hidden_dim=HIDDEN_DIM,\n",
    "        n_actions=n_actions,\n",
    "        actor_lr=1e-4,\n",
    "        critic_lr=3e-4,\n",
    "        gamma=0.99,\n",
    "        gae_lambda=0.95,\n",
    "        clip_epsilon=0.2,\n",
    "        n_epochs=10,\n",
    "        batch_size=BATCH_SIZE,\n",
    "        use_recurrent=True,\n",
    "        rnn_type='GRU',\n",
    "        entropy_coef=0.08,\n",
    "        use_amp=(DEVICE == 'cuda'),\n",
    "    )\n",
    "    \n",
    "    # Adversary config based on type\n",
    "    if adversary_type == 'discrete_4':\n",
    "        adversary_config = PPOConfig(\n",
    "            state_dim=state_dim,\n",
    "            hidden_dim=128,\n",
    "            n_actions=4,\n",
    "            actor_lr=5e-5,\n",
    "            critic_lr=1e-4,\n",
    "            use_recurrent=True,\n",
    "        )\n",
    "    elif adversary_type == 'discrete_16':\n",
    "        adversary_config = PPOConfig(\n",
    "            state_dim=state_dim,\n",
    "            hidden_dim=128,\n",
    "            n_actions=16,\n",
    "            actor_lr=5e-5,\n",
    "            critic_lr=1e-4,\n",
    "            use_recurrent=True,\n",
    "        )\n",
    "    else:  # continuous\n",
    "        adversary_config = PPOConfig(\n",
    "            state_dim=state_dim,\n",
    "            hidden_dim=128,\n",
    "            n_actions=state_dim,\n",
    "            actor_lr=5e-5,\n",
    "            critic_lr=1e-4,\n",
    "            use_recurrent=True,\n",
    "        )\n",
    "    \n",
    "    # Training config\n",
    "    training_config = AdversarialConfig(\n",
    "        n_iterations=n_iterations,\n",
    "        steps_per_iteration=STEPS_PER_ITER,\n",
    "        trader_config=trader_config,\n",
    "        adversary_config=adversary_config,\n",
    "        adversary_start_iteration=ADVERSARY_START,\n",
    "        adversary_strength=ADVERSARY_STRENGTH,\n",
    "        save_frequency=50,\n",
    "        log_frequency=10,\n",
    "        checkpoint_dir=save_dir,\n",
    "    )\n",
    "    \n",
    "    # Create trainer\n",
    "    trainer = AdversarialTrainer(env, training_config, device=DEVICE)\n",
    "    \n",
    "    # Replace/modify adversary based on type\n",
    "    if adversary_type == 'discrete_16':\n",
    "        trainer.adversary = Discrete16AdversaryPPO(\n",
    "            state_dim=state_dim,\n",
    "            n_actions=DISCRETE_16_N_ACTIONS,\n",
    "            hidden_dim=128,\n",
    "            lr=5e-5,\n",
    "            gamma=0.99,\n",
    "            strength=ADVERSARY_STRENGTH,\n",
    "            device=DEVICE\n",
    "        )\n",
    "    \n",
    "    elif adversary_type == 'continuous':\n",
    "        trainer.adversary = ContinuousAdversaryPPO(\n",
    "            state_dim=state_dim,\n",
    "            hidden_dim=128,\n",
    "            lr=5e-5,\n",
    "            gamma=0.99,\n",
    "            epsilon=PGD_EPSILON,\n",
    "            device=DEVICE\n",
    "        )\n",
    "        \n",
    "        # Override apply method for continuous\n",
    "        def continuous_apply(obs, adv_action, env_info):\n",
    "            if trainer.iteration < trainer.config.adversary_start_iteration:\n",
    "                return obs.copy(), {'type': 'none'}\n",
    "            perturbation, value = trainer.adversary.select_action(obs)\n",
    "            modified_obs = trainer.adversary.apply_perturbation(obs, perturbation)\n",
    "            return modified_obs, {'type': 'continuous', 'perturbation_norm': np.linalg.norm(perturbation)}\n",
    "        \n",
    "        trainer._apply_adversary_modification = continuous_apply\n",
    "    \n",
    "    # Train\n",
    "    print(f'\\n{\"=\"*60}')\n",
    "    print(f'TRAINING: {adversary_type.upper()} ADVERSARY')\n",
    "    print(f'{\"=\"*60}')\n",
    "    \n",
    "    start_time = time.time()\n",
    "    \n",
    "    try:\n",
    "        trainer.train(vec_env=vec_env, steps_per_env=STEPS_PER_ENV)\n",
    "    except KeyboardInterrupt:\n",
    "        print('Training interrupted')\n",
    "    \n",
    "    elapsed = time.time() - start_time\n",
    "    print(f'Training completed in {elapsed/60:.1f} minutes')\n",
    "    \n",
    "    # Return metrics\n",
    "    return {\n",
    "        'adversary_type': adversary_type,\n",
    "        'iterations': trainer.history.get('iteration', list(range(n_iterations))),\n",
    "        'mean_returns': trainer.history.get('mean_return', []),\n",
    "        'mean_rewards': trainer.history.get('mean_reward', []),\n",
    "        'trader_profits': trainer.history.get('total_profit', []),\n",
    "        'elapsed_minutes': elapsed / 60\n",
    "    }\n",
    "\n",
    "print('Training function defined (supports 3 approaches).')"
   ]
  },
