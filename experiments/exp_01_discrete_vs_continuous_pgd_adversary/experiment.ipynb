   "metadata": {},
   "source": [
    "## Define Discrete-16 Adversary"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ═══════════════════════════════════════════════════════════════════════\n",
    "# DISCRETE-16 ADVERSARY\n",
    "# ═══════════════════════════════════════════════════════════════════════\n",
    "\n",
    "import torch.nn as nn\n",
    "\n",
    "class Discrete16AdversaryPPO:\n",
    "    \"\"\"\n",
    "    Discrete adversary with 16 actions.\n",
    "    \n",
    "    Actions 0-3:  Noise with different strengths (0.1, 0.2, 0.3, 0.5)\n",
    "    Actions 4-7:  Trend bias with different strengths\n",
    "    Actions 8-11: Signal inversion with different strengths\n",
    "    Actions 12-15: No modification (baseline observations)\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(\n",
    "        self,\n",
    "        state_dim: int,\n",
    "        n_actions: int = 16,\n",
    "        hidden_dim: int = 128,\n",
    "        lr: float = 3e-4,\n",
    "        gamma: float = 0.99,\n",
    "        strength: float = 0.1,\n",
    "        device: str = 'cuda'\n",
    "    ):\n",
    "        self.state_dim = state_dim\n",
    "        self.n_actions = n_actions\n",
    "        self.strength = strength\n",
    "        self.device = device\n",
    "        self.gamma = gamma\n",
    "        \n",
    "        # Actor: Categorical policy\n",
    "        self.actor = nn.Sequential(\n",
    "            nn.Linear(state_dim, hidden_dim),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(hidden_dim, hidden_dim),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(hidden_dim, n_actions)\n",
    "        ).to(device)\n",
    "        \n",
    "        # Critic\n",
    "        self.critic = nn.Sequential(\n",
    "            nn.Linear(state_dim, hidden_dim),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(hidden_dim, 1)\n",
    "        ).to(device)\n",
    "        \n",
    "        self.actor_opt = torch.optim.Adam(self.actor.parameters(), lr=lr)\n",
    "        self.critic_opt = torch.optim.Adam(self.critic.parameters(), lr=lr)\n",
    "        \n",
    "        # Buffer\n",
    "        self.buffer = {\n",
    "            'states': [], 'actions': [], 'rewards': [],\n",
    "            'values': [], 'log_probs': [], 'dones': []\n",
    "        }\n",
    "    \n",
    "    def select_action(self, state: np.ndarray):\n",
    "        \"\"\"Select discrete action.\"\"\"\n",
    "        state_t = torch.FloatTensor(state).unsqueeze(0).to(self.device)\n",
    "        \n",
    "        with torch.no_grad():\n",
    "            logits = self.actor(state_t)\n",
    "            probs = torch.softmax(logits, dim=-1)\n",
    "            dist = torch.distributions.Categorical(probs)\n",
    "            action = dist.sample().item()\n",
    "            value = self.critic(state_t).item()\n",
    "        \n",
    "        return action, value\n",
    "    \n",
    "    def apply_modification(self, obs: np.ndarray, action: int) -> np.ndarray:\n",
    "        \"\"\"Apply the selected action to observation.\"\"\"\n",
    "        modified = obs.copy()\n",
    "        \n",
    "        if action < 4:\n",
    "            # Noise with different strengths\n",
    "            strength = self.strength * (0.2 + action * 0.2)\n",
    "            noise = np.random.randn(len(obs)) * strength\n",
    "            modified += noise\n",
    "            \n",
    "        elif action < 8:\n",
    "            # Trend bias with different strengths\n",
    "            strength = self.strength * (0.2 + (action-4) * 0.2)\n",
    "            n_features = min(5, len(obs) // 2)\n",
    "            bias = np.random.randn() * strength\n",
    "            modified[:n_features] += bias\n",
    "            \n",
    "        elif action < 12:\n",
    "            # Signal inversion with different strengths\n",
    "            n_invert = max(1, (action - 8 + 1) * 2)\n",
    "            invert_indices = np.random.choice(len(obs), n_invert, replace=False)\n",
    "            modified[invert_indices] *= -1\n",
    "        # else: no modification (actions 12-15)\n",
    "        \n",
    "        return np.clip(modified, -10.0, 10.0)\n",
    "    \n",
    "    def store(self, state, action, reward, value, log_prob, done):\n",
    "        self.buffer['states'].append(state)\n",
    "        self.buffer['actions'].append(action)\n",
    "        self.buffer['rewards'].append(reward)\n",
    "        self.buffer['values'].append(value)\n",
    "        self.buffer['log_probs'].append(log_prob)\n",
    "        self.buffer['dones'].append(done)\n",
    "    \n",
    "    def update(self, next_value: float = 0.0):\n",
    "        \"\"\"Update actor and critic.\"\"\"\n",
    "        if not self.buffer['states']:\n",
    "            return {}\n",
    "        \n",
    "        states = torch.FloatTensor(np.array(self.buffer['states'])).to(self.device)\n",
    "        actions = torch.LongTensor(np.array(self.buffer['actions'])).to(self.device)\n",
    "        rewards = np.array(self.buffer['rewards'])\n",
    "        values = np.array(self.buffer['values'] + [next_value])\n",
    "        dones = np.array(self.buffer['dones'])\n",
    "        \n",
    "        # GAE\n",
    "        advantages = np.zeros_like(rewards)\n",
    "        gae = 0\n",
    "        for t in reversed(range(len(rewards))):\n",
    "            delta = rewards[t] + self.gamma * values[t+1] * (1 - dones[t]) - values[t]\n",
    "            gae = delta + self.gamma * 0.95 * (1 - dones[t]) * gae\n",
    "            advantages[t] = gae\n",
    "        \n",
    "        returns = advantages + values[:-1]\n",
    "        advantages_t = torch.FloatTensor(advantages).to(self.device)\n",
    "        returns_t = torch.FloatTensor(returns).to(self.device)\n",
    "        \n",
    "        # Update critic\n",
    "        value_pred = self.critic(states).squeeze()\n",
    "        critic_loss = nn.MSELoss()(value_pred, returns_t)\n",
    "        self.critic_opt.zero_grad()\n",
    "        critic_loss.backward()\n",
    "        self.critic_opt.step()\n",
    "        \n",
    "        # Update actor\n",
    "        logits = self.actor(states)\n",
    "        probs = torch.softmax(logits, dim=-1)\n",
    "        dist = torch.distributions.Categorical(probs)\n",
    "        log_probs = dist.log_prob(actions)\n",
    "        \n",
    "        actor_loss = -(log_probs * advantages_t.detach()).mean()\n",
    "        self.actor_opt.zero_grad()\n",
    "        actor_loss.backward()\n",
    "        self.actor_opt.step()\n",
    "        \n",
    "        self.clear_buffer()\n",
    "        \n",
    "        return {'actor_loss': actor_loss.item(), 'critic_loss': critic_loss.item()}\n",
    "    \n",
    "    def clear_buffer(self):\n",
    "        for k in self.buffer:\n",
    "            self.buffer[k] = []\n",
    "    \n",
    "    def save(self, path: str):\n",
    "        torch.save({'actor': self.actor.state_dict(), 'critic': self.critic.state_dict()}, path)\n",
    "    \n",
    "    def load(self, path: str):\n",
    "        ckpt = torch.load(path, map_location=self.device)\n",
    "        self.actor.load_state_dict(ckpt['actor'])\n",
    "        self.critic.load_state_dict(ckpt['critic'])\n",
    "\n",
    "print('Discrete-16 Adversary defined.')"
   ]
  },
