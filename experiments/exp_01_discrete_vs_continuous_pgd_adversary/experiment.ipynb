   "metadata": {},
   "source": [
    "## Define Continuous (PGD) Adversary"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ═══════════════════════════════════════════════════════════════════════\n",
    "# CONTINUOUS (PGD) ADVERSARY\n",
    "# ═══════════════════════════════════════════════════════════════════════\n",
    "\n",
    "class ContinuousAdversaryPPO:\n",
    "    \"\"\"\n",
    "    PGD-style continuous adversary.\n",
    "    \n",
    "    Key features:\n",
    "    - Gaussian policy: Learn exact perturbation per feature\n",
    "    - L2-norm clipping for stability\n",
    "    - Continuous action space (one value per feature)\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(\n",
    "        self,\n",
    "        state_dim: int,\n",
    "        hidden_dim: int = 128,\n",
    "        lr: float = 3e-4,\n",
    "        gamma: float = 0.99,\n",
    "        epsilon: float = 0.02,  # Max 2% perturbation per feature\n",
    "        device: str = 'cuda'\n",
    "    ):\n",
    "        self.state_dim = state_dim\n",
    "        self.epsilon = epsilon\n",
    "        self.device = device\n",
    "        self.gamma = gamma\n",
    "        \n",
    "        # Actor: Gaussian policy\n",
    "        self.actor_mean = nn.Sequential(\n",
    "            nn.Linear(state_dim, hidden_dim),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(hidden_dim, hidden_dim),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(hidden_dim, state_dim)  # One perturbation per feature\n",
    "        ).to(device)\n",
    "        \n",
    "        # Learnable log_std\n",
    "        self.log_std = nn.Parameter(torch.zeros(state_dim)).to(device)\n",
    "        \n",
    "        # Critic\n",
    "        self.critic = nn.Sequential(\n",
    "            nn.Linear(state_dim, hidden_dim),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(hidden_dim, 1)\n",
    "        ).to(device)\n",
    "        \n",
    "        self.actor_opt = torch.optim.Adam([\n",
    "            {'params': self.actor_mean.parameters()},\n",
    "            {'params': [self.log_std]}\n",
    "        ], lr=lr)\n",
    "        self.critic_opt = torch.optim.Adam(self.critic.parameters(), lr=lr)\n",
    "        \n",
    "        # Buffer\n",
    "        self.buffer = {\n",
    "            'states': [], 'actions': [], 'rewards': [],\n",
    "            'values': [], 'log_probs': [], 'dones': []\n",
    "        }\n",
    "    \n",
    "    def select_action(self, state: np.ndarray, deterministic: bool = False):\n",
    "        \"\"\"Select perturbation action.\"\"\"\n",
    "        state_t = torch.FloatTensor(state).unsqueeze(0).to(self.device)\n",
    "        \n",
    "        with torch.no_grad():\n",
    "            mean = self.actor_mean(state_t)\n",
    "            std = torch.exp(self.log_std)\n",
    "            \n",
    "            if deterministic:\n",
    "                perturbation = mean\n",
    "            else:\n",
    "                dist = torch.distributions.Normal(mean, std)\n",
    "                perturbation = dist.sample()\n",
    "            \n",
    "            # PGD-style L2 clipping\n",
    "            perturbation = self._clip_perturbation(perturbation)\n",
    "            \n",
    "            value = self.critic(state_t).item()\n",
    "        \n",
    "        return perturbation.squeeze(0).cpu().numpy(), value\n",
    "    \n",
    "    def _clip_perturbation(self, perturbation: torch.Tensor) -> torch.Tensor:\n",
    "        \"\"\"Apply L2-norm clipping (PGD-style).\"\"\"\n",
    "        norm = perturbation.norm()\n",
    "        if norm > self.epsilon:\n",
    "            perturbation = perturbation * (self.epsilon / norm)\n",
    "        return perturbation\n",
    "    \n",
    "    def apply_perturbation(self, obs: np.ndarray, perturbation: np.ndarray) -> np.ndarray:\n",
    "        \"\"\"Apply perturbation to observation.\"\"\"\n",
    "        modified = obs + perturbation\n",
    "        return np.clip(modified, -10.0, 10.0)\n",
    "    \n",
    "    def store(self, state, action, reward, value, log_prob, done):\n",
    "        self.buffer['states'].append(state)\n",
    "        self.buffer['actions'].append(action)\n",
    "        self.buffer['rewards'].append(reward)\n",
    "        self.buffer['values'].append(value)\n",
    "        self.buffer['log_probs'].append(log_prob)\n",
    "        self.buffer['dones'].append(done)\n",
    "    \n",
    "    def update(self, next_value: float = 0.0):\n",
    "        \"\"\"Update actor and critic.\"\"\"\n",
    "        if not self.buffer['states']:\n",
    "            return {}\n",
    "        \n",
    "        states = torch.FloatTensor(np.array(self.buffer['states'])).to(self.device)\n",
    "        actions = torch.FloatTensor(np.array(self.buffer['actions'])).to(self.device)\n",
    "        rewards = np.array(self.buffer['rewards'])\n",
    "        values = np.array(self.buffer['values'] + [next_value])\n",
    "        dones = np.array(self.buffer['dones'])\n",
    "        \n",
    "        # GAE\n",
    "        advantages = np.zeros_like(rewards)\n",
    "        gae = 0\n",
    "        for t in reversed(range(len(rewards))):\n",
    "            delta = rewards[t] + self.gamma * values[t+1] * (1 - dones[t]) - values[t]\n",
    "            gae = delta + self.gamma * 0.95 * (1 - dones[t]) * gae\n",
    "            advantages[t] = gae\n",
    "        \n",
    "        returns = advantages + values[:-1]\n",
    "        advantages_t = torch.FloatTensor(advantages).to(self.device)\n",
    "        returns_t = torch.FloatTensor(returns).to(self.device)\n",
    "        \n",
    "        # Update critic\n",
    "        value_pred = self.critic(states).squeeze()\n",
    "        critic_loss = nn.MSELoss()(value_pred, returns_t)\n",
    "        self.critic_opt.zero_grad()\n",
    "        critic_loss.backward()\n",
    "        self.critic_opt.step()\n",
    "        \n",
    "        # Update actor\n",
    "        mean = self.actor_mean(states)\n",
    "        std = torch.exp(self.log_std).expand_as(mean)\n",
    "        dist = torch.distributions.Normal(mean, std)\n",
    "        log_probs = dist.log_prob(actions).sum(dim=-1)\n",
    "        \n",
    "        actor_loss = -(log_probs * advantages_t.detach()).mean()\n",
    "        self.actor_opt.zero_grad()\n",
    "        actor_loss.backward()\n",
    "        self.actor_opt.step()\n",
    "        \n",
    "        self.clear_buffer()\n",
    "        \n",
    "        return {'actor_loss': actor_loss.item(), 'critic_loss': critic_loss.item()}\n",
    "    \n",
    "    def clear_buffer(self):\n",
    "        for k in self.buffer:\n",
    "            self.buffer[k] = []\n",
    "    \n",
    "    def save(self, path: str):\n",
    "        torch.save({\n",
    "            'actor_mean': self.actor_mean.state_dict(),\n",
    "            'log_std': self.log_std,\n",
    "            'critic': self.critic.state_dict()\n",
    "        }, path)\n",
    "    \n",
    "    def load(self, path: str):\n",
    "        ckpt = torch.load(path, map_location=self.device)\n",
    "        self.actor_mean.load_state_dict(ckpt['actor_mean'])\n",
    "        self.log_std = ckpt['log_std']\n",
    "        self.critic.load_state_dict(ckpt['critic'])\n",
    "\n",
    "print('Continuous (PGD) Adversary defined.')"
   ]
  },
